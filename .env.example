OPENAI_API_KEY="PUT_YOUR_OPENAI_API_KEY"
LANGCHAIN_API_KEY="PUT_YOUR_LANGCHAIN_API_KEY"
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_PROJECT="sample"

AZURE_OPENAI_API_KEY="PUT_YOUR_AZURE_OPENAI_API_KEY"
AZURE_OPENAI_ENDPOINT="https://YOUR_RESOURCE.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="YOUR_CHAT_DEPLOYMENT"
AZURE_OPENAI_API_VERSION="YOUR_API_VERSION"

# Optional onboarding JSON; it must contain the actual participant's user_id.
# MAYA_SESSION_CONFIG="/absolute/path/to/session.json"
# Required participant ID when no session JSON is supplied; there is no fallback ID.
# MAYA_RUN_USER_ID="participant-001"
# Optional bounded dialogue configuration for follow-up routing.
# MAYA_CONVERSATION_CONFIG="/absolute/path/to/conversation.json"
# Optional exercise-session provider configuration; disabled unless configured.
# Phyxio: select session_config.phyxio.example.json; participant identity comes from the session JSON.
# MAYA_EXERCISE_SESSION_CONFIG="/absolute/path/to/session_config.json"
# MAYA_ENABLE_PHYXIO_IO=1
# MAYA_PERSONALITY="supportive"
# MAYA_ASR_LANGUAGE="auto"
# AZURE_SPEECH_VOICE="en-GB-RyanNeural"
# AZURE_SPEECH_KEY="YOUR_SPEECH_KEY"
# AZURE_SPEECH_REGION="YOUR_SPEECH_REGION"
# ASR: choose OpenAI Whisper or the Azure Whisper settings used by your deployment.
# OPENAI_WHISPER_API_KEY="YOUR_WHISPER_KEY"
# OPENAI_WHISPER_MODEL="whisper-1"
# AZURE_OPENAI_WHISPER_API_KEY="YOUR_AZURE_WHISPER_KEY"
# AZURE_OPENAI_WHISPER_ENDPOINT="https://YOUR_RESOURCE.openai.azure.com/"
# AZURE_OPENAI_DEPLOYMENT_WHISPER="YOUR_WHISPER_DEPLOYMENT"
# AZURE_OPENAI_WHISPER_API_VERSION="YOUR_SUPPORTED_API_VERSION"
# Mirror microphone selection and recovery (PortAudio device index; unset uses its default).
# MAYA_MIC_DEVICE=0
# MAYA_VOICE_SECONDS=20
# MAYA_VOICE_POLL_SECONDS=0.1
# MAYA_VOICE_ERROR_TEXT="Voice input is temporarily unavailable. Please tap to try again."
# Optional complete response-policy JSON (wording, labels and pilot privacy URL).
# MAYA_RESPONSE_POLICY="/absolute/path/to/response_policy.json"

# Preferred Postgres DSN for LangGraph (local or managed):
# For local development (no SSL):
MAYA_DB_URI="postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable"
# For managed DBs (use SSL):
# MAYA_DB_URI="postgresql://user:pass@host:5432/dbname?sslmode=require"

# Optional connection pool settings
# MAYA_DB_POOL_MIN_SIZE=1
# MAYA_DB_POOL_MAX_SIZE=10

# Fallback: you can also set DATABASE_URL instead of MAYA_DB_URI
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# Bound individual model requests; avoid silent retries during conversation.
MAYA_MODEL_TIMEOUT_SECONDS=45
MAYA_MODEL_MAX_RETRIES=0

# Optional observation provider configuration. Unset = disabled.
# FHIR: copy config.fhir.example.json outside the repository and configure credentials/patient_map.
# MAYA_BIOMARKER_CONFIG=/absolute/path/to/private/biomarkers.json
# Synthetic data requires its dedicated session:
# MAYA_BIOMARKER_CONFIG=/absolute/path/to/maya/framework/integrations/biomarkers/config.example.json
