# Shell-sourced settings, not a systemd EnvironmentFile (shell expansion required).
# Set MAYA_CONFIG_DIR to an absolute directory containing the copied JSON profile
# and the separately supplied private client-rgu.json before sourcing this file.
MAYA_SESSION_CONFIG="${MAYA_CONFIG_DIR:?Set an absolute private configuration directory}/session.json"
MAYA_BIOMARKER_CONFIG="$MAYA_CONFIG_DIR/biomarkers.json"
MAYA_EXERCISE_SESSION_CONFIG="$MAYA_CONFIG_DIR/exercise.json"
MAYA_ENABLE_PHYXIO_IO="1"
MAYA_HEALTH_RAG_BACKEND="pgvector"
MAYA_HEALTH_RAG_EMBEDDINGS="huggingface"
MAYA_MODEL_TIMEOUT_SECONDS="45"
MAYA_MODEL_MAX_RETRIES="0"
MAYA_RUN_THREAD_ID=""
LANGSMITH_TRACING="false"
LANGCHAIN_TRACING_V2="false"
